# Funciona como está: sem Supabase, o app abre e o modo demo roda com dados locais.
# Para contas reais, troque pelos dados do seu projeto (ou do "supabase start").
SUPABASE_PROJECT_ID=local
SUPABASE_PUBLISHABLE_KEY=sb_publishable_local
SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PROJECT_ID=local
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Opcional. Com a API no ar, as escritas passam por ela. Ex.: http://localhost:3001
VITE_API_URL=
