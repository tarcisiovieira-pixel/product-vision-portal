NODE_ENV=development
PORT=3001
LOG_LEVEL=info
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
RATE_LIMIT_MAX=120
TRUST_PROXY_HOPS=1
# IA generativa (opcional): sem chave, as IAs usam só o motor de regras.
# Gemini tem camada gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Alternativa paga. Com as duas chaves, o Gemini vence (ou force com AI_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_DAILY_LIMIT=30
